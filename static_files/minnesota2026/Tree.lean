
inductive Tree (α : Type u) where
  | leaf
  | node (left : Tree α) (a : α) (right : Tree α)

def Tree.map (f : α → β) : Tree α → Tree β
  | .leaf => .leaf
  | .node l a r => .node (map f l) (f a) (map f r)

